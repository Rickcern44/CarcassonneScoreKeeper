{
	"name": "carc-keeper-sk",
	"version": "0.0.1",
	"private": true,
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"playwright-test": "playwright test",
		"test:e2e": "playwright test -c playwright.e2e.config.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"lint": "biome check .",
		"format": "biome format --write .",
		"aspire:start": "npm --prefix aspire-apphost run aspire:start",
		"aspire:build": "npm --prefix aspire-apphost run aspire:build",
		"aspire:dev": "npm --prefix aspire-apphost run aspire:dev"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@playwright/test": "^1.64.1",
		"@skeletonlabs/skeleton": "^5.0.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/forms": "^0.5.3",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.19.2",
		"drizzle-kit": "^0.31.11",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"svelte-feather-icons": "^3.6.0",
		"tailwindcss": "^4.3.3",
		"tslib": "^2.4.1",
		"typescript": "^6.0.0",
		"vite": "^8.0.12",
		"vitest": "^4.1.12"
	},
	"type": "module",
	"dependencies": {
		"@floating-ui/dom": "^1.4.3",
		"@vercel/kv": "^0.2.2",
		"drizzle-orm": "^0.45.4",
		"postgres": "^3.4.9"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
