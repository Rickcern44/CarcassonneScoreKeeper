{
	"name": "carc-keeper-sk",
	"version": "0.0.1",
	"private": true,
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"playwright-test": "playwright test",
		"test:e2e": "playwright test -c playwright.e2e.config.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"lint": "biome check .",
		"format": "biome format --write .",
		"aspire:start": "npm --prefix aspire-apphost run aspire:start",
		"aspire:build": "npm --prefix aspire-apphost run aspire:build",
		"aspire:dev": "npm --prefix aspire-apphost run aspire:dev"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@playwright/test": "^1.28.1",
		"@skeletonlabs/skeleton": "^2.11.0",
		"@skeletonlabs/tw-plugin": "^0.4.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/forms": "^0.5.3",
		"autoprefixer": "^10.4.14",
		"drizzle-kit": "^0.31.11",
		"postcss": "^8.4.24",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"svelte-feather-icons": "^3.6.0",
		"tailwindcss": "^3.3.2",
		"tslib": "^2.4.1",
		"typescript": "^5.9.3",
		"vite": "^7.3.7",
		"vitest": "^3.2.7"
	},
	"type": "module",
	"dependencies": {
		"@floating-ui/dom": "^1.4.3",
		"@vercel/kv": "^0.2.2",
		"drizzle-orm": "^0.45.4",
		"postgres": "^3.4.9"
	}
}
