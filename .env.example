APP_PASSWORD=
DATABASE_URL=postgresql://user:password@localhost:5432/carcassonne
# Optional: a direct (non-pooled) connection used only for migrations (Neon).
# MIGRATE_DATABASE_URL=
# Optional: marks a deployment. "staging" shows the orange staging banner and
# installs as "Carc Staging". Leave unset for production. Nothing is needed
# locally: the dev server (npm run dev, Aspire) shows the Local banner itself.
# APP_ENV=
